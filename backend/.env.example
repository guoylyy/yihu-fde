# Copy to backend/.env for local development. Only the first block is required.

# ---------- Required ----------
DATABASE_URL="mysql://root:password@127.0.0.1:3306/fde"
# Generate with: openssl rand -hex 32 (the backend refuses to start in production without it)
JWT_SECRET=""
PORT=3005
NODE_ENV=development

# ---------- General ----------
# Public URL of this deployment; used for links in emails and the MCP config download
PUBLIC_BASE_URL=
# Override the MCP endpoint written into developer kits (default: PUBLIC_BASE_URL + /api/mcp)
PUBLIC_MCP_URL=
# Project code prefix: PRJ-2026-0001
PROJECT_CODE_PREFIX=PRJ
# Background jobs (repo sync, activity scores, notification digests). Set to false to disable.
ENABLE_CRON=true
JWT_EXPIRES_IN=7d
# Log external messages (mail/chat) instead of sending them
MOCK_MODE=false

# ---------- Single sign-on (OIDC, e.g. Yihu One) ----------
# Register this app in the identity provider with redirect URI <PUBLIC_BASE_URL>/api/auth/oidc/callback
# Leave OIDC_ISSUER empty to disable. With it set, the login page shows "Sign in with <OIDC_NAME>".
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=以虎 One
# Default: PUBLIC_BASE_URL + /api/auth/oidc/callback (or derived from the request)
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
# Backend-to-IdP base URL when it differs from the public issuer (e.g. inside Docker)
OIDC_INTERNAL_URL=
# Create a local account on first sign-in; link to an existing account by verified email
OIDC_AUTO_CREATE=true
OIDC_LINK_BY_EMAIL=true
# Role for new accounts; IdP roles (claim OIDC_ROLES_CLAIM) listed in OIDC_ADMIN_ROLES become ADMIN
OIDC_DEFAULT_ROLE=FDE_ENGINEER
OIDC_ADMIN_ROLES=ADMIN
OIDC_ROLES_CLAIM=roles
# Set to false to allow only single sign-on (the login page then goes straight to the IdP)
PASSWORD_LOGIN=true

# ---------- Branding ----------
BRAND_NAME=
BRAND_TAGLINE=
BRAND_LOGO_URL=
BRAND_PRIMARY_COLOR=
BRAND_SITE_URL=

# ---------- Modules ----------
# Leave both empty for everything. Whitelist wins over blacklist. Module codes: see src/config/modules.js
ENABLED_MODULES=
DISABLED_MODULES=

# ---------- File storage ----------
# local (default) | s3 | qiniu
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# S3-compatible (AWS S3, MinIO, Cloudflare R2, Aliyun OSS...)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL prefix for objects, e.g. a CDN domain
S3_PUBLIC_URL=
# true for MinIO
S3_FORCE_PATH_STYLE=false
# Qiniu
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
QINIU_REGION=z0

# ---------- Team chat notifications ----------
# Webhook of a Feishu/Lark, DingTalk, WeCom or Slack bot, or any URL accepting JSON
CHAT_WEBHOOK_URL=
# FEISHU | DINGTALK | WECOM | SLACK | WEBHOOK (guessed from the URL when empty)
CHAT_WEBHOOK_CHANNEL=
# Signing secret (Feishu/DingTalk)
CHAT_WEBHOOK_SECRET=

# ---------- Email (SMTP) ----------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

# ---------- Git hosting (repository commit sync) ----------
# Any token enables the sync job; REPO_SYNC_ENABLED=true syncs public repos without a token
GITHUB_TOKEN=
GITLAB_TOKEN=
GITEE_ACCESS_TOKEN=
REPO_SYNC_ENABLED=false
