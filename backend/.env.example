# Local development only. On Yihu One every value below that matters is injected by the platform
# (database, credentials, public URL, upload dir); see src/lib/platform.js.
# Copy to backend/.env.

# ---------- Required ----------
DATABASE_URL="mysql://root:password@127.0.0.1:3306/fde"
PORT=3005
NODE_ENV=development
# Generate with: openssl rand -hex 32 (on Yihu One it is derived from the app credentials)
JWT_SECRET=""

# ---------- Signing in locally ----------
# Option A: dev login, no Yihu One needed. The login page lists a username field; refused in production
# and when running on Yihu One. The integration tests use it too.
DEV_LOGIN=true
# Option B: sign in with your own Yihu One. Register the app there (管理 → 应用 → 登记外部应用) with redirect URI
# http://localhost:5173/api/auth/oidc/callback, then fill in:
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Backend-to-platform address when it differs from the browser address (e.g. inside Docker)
OIDC_INTERNAL_URL=

# ---------- Optional: account rules (same defaults on Yihu One) ----------
# Role for accounts created on first sign-in; platform roles listed in OIDC_ADMIN_ROLES are always admins here
OIDC_DEFAULT_ROLE=FDE_ENGINEER
OIDC_ADMIN_ROLES=ADMIN
# false = an admin has to add people from the Yihu One directory before they can sign in
OIDC_AUTO_CREATE=true
OIDC_LINK_BY_EMAIL=true

# ---------- Optional ----------
# Project code prefix: PRJ-2026-0001
PROJECT_CODE_PREFIX=PRJ
# Background jobs (directory and model sync, repo sync, activity scores, digests). Set to false to disable.
ENABLE_CRON=true
JWT_EXPIRES_IN=7d
# Log external messages (chat) instead of sending them
MOCK_MODE=false
# Relax rate limits 100x for the integration tests (never in production)
RATELIMIT_RELAX=false
# Turn modules off per instance. Module codes: see src/config/modules.js
ENABLED_MODULES=
DISABLED_MODULES=
UPLOAD_DIR=./uploads

# ---------- Team chat notifications (group bots; personal messages go through Yihu One) ----------
# Webhook of a Feishu/Lark, DingTalk, WeCom or Slack bot, or any URL accepting JSON
CHAT_WEBHOOK_URL=
# FEISHU | DINGTALK | WECOM | SLACK | WEBHOOK (guessed from the URL when empty)
CHAT_WEBHOOK_CHANNEL=
# Signing secret (Feishu/DingTalk)
CHAT_WEBHOOK_SECRET=

# ---------- Git hosting (repository commit sync) ----------
# Any token enables the sync job; REPO_SYNC_ENABLED=true syncs public repos without a token
GITHUB_TOKEN=
GITLAB_TOKEN=
GITEE_ACCESS_TOKEN=
REPO_SYNC_ENABLED=false
