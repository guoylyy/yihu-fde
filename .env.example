# Docker Compose settings. Copy to .env and fill in the required values.
# Any variable from backend/.env.example (storage, chat, SMTP, git tokens, branding...) can be added here too.

# ---------- Required ----------
MYSQL_PASSWORD=
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ---------- Common ----------
APP_PORT=8080
# Public URL of this deployment, e.g. https://fde.example.com
PUBLIC_BASE_URL=
BRAND_NAME=

# Optional build mirrors for slow networks
# APK_MIRROR=mirrors.aliyun.com
# NPM_REGISTRY=https://registry.npmmirror.com
# PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma
